LAYOUT PATH  "topCell.gds"
LAYOUT PRIMARY "topCell"
LAYOUT SYSTEM GDSII

SOURCE PATH "topCell.cdl"
SOURCE PRIMARY "topCell"
SOURCE SYSTEM SPICE

MASK SVDB DIRECTORY "svdb" QUERY XRC

LVS REPORT "topCell.lvs.report"

//PEX NETLIST "topCell.pex.netlist" CALIBREVIEW 1 SOURCENAMES GROUND "GND" SEPARATOR "/" LOCATION 
//PEX NETLIST "topCell.pex.netlist" SPECTRE 1 SOURCENAMES GROUND "GND" SEPARATOR "/" 
PEX NETLIST "topCell.pex.netlist" HSPICE 1 SOURCENAMES 
PEX FIELDSOLVER MODE 200
PEX REDUCE ANALOG NO
PEX NETLIST UPPERCASE KEYWORDS NO
PEX NETLIST VIRTUAL CONNECT NO
PEX NETLIST NOXREF NET NAMES YES
PEX NETLIST MUTUAL RESISTANCE YES
LVS REPORT OPTION NONE
LVS FILTER UNUSED OPTION NONE SOURCE
LVS FILTER UNUSED OPTION NONE LAYOUT
LVS POWER NAME
	"topPower"

LVS GROUND NAME
	"topGround"


LVS RECOGNIZE GATES ALL



VIRTUAL CONNECT COLON NO
VIRTUAL CONNECT REPORT NO
VIRTUAL CONNECT NAME "topPower" "topGround"

DRC ICSTATION YES


LVS REDUCTION PRIORITY SERIES


INCLUDE "pex_rule"
